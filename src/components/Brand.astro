---
import horizontalLogo from '../assets/nataly-risco-horizontal.png';
import stackedLogo from '../assets/nataly-risco-apilado.png';

interface Props { stacked?: boolean }

const logo = Astro.props.stacked ? stackedLogo : horizontalLogo;
---
<a class="brand" href="/">
  <img src={logo.src} width={logo.width} height={logo.height} alt="Nataly Risco · Pastelería Creativa" />
  <span class="sr-only">Inicio</span>
</a>
