---
import SiteLayout from '../layouts/SiteLayout.astro';
import ContactLink from '../components/ContactLink.astro';
import Gallery from '../components/Gallery.astro';
import ResponsivePhoto from '../components/ResponsivePhoto.astro';
import { photography } from '../data/gallery';
import { faqs, registration, site, venueMessage } from '../data/site';
import { isOpen, workshops } from '../data/workshops';

const description = `Talleres presenciales de repostería en ${site.city}. Explora los temarios y consulta fechas y condiciones por WhatsApp.`;
const school = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: site.name,
  telephone: site.whatsapp.display,
  sameAs: [site.facebookUrl],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.venue?.address,
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'PE',
  },
};
---
<SiteLayout title={site.name} description={description} structuredData={school} ogPhoto={photography.hero}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-place">{site.city}, {site.region}</p>
      <h1 id="hero-title">Repostería <em>presencial</em></h1>
      <p class="hero-description">Talleres de masas, tortas y postres. Consulta las próximas fechas con la escuela.</p>
      <div class="actions">
        <a class="button" href="#talleres">Ver talleres</a>
        <a class="button button-outline" href="#ubicacion">Dónde se dictan</a>
      </div>
    </div>
    <figure class="hero-photo">
      <ResponsivePhoto photo={photography.hero} sizes="(min-width: 80rem) 660px, (min-width: 55rem) 52vw, 94vw" priority />
      <figcaption>{photography.hero.caption}</figcaption>
    </figure>
  </section>

  <section class="section wrap workshops-section" id="talleres" tabindex="-1" aria-labelledby="workshops-title">
    <header class="section-heading">
      <h2 id="workshops-title">Temarios de taller</h2>
      <p>Revisa el contenido y consulta por una próxima edición.</p>
    </header>
    <ul class="workshop-grid" role="list">
      {workshops.map((workshop) => (
        <li>
          <article class:list={['workshop-card', `workshop-${workshop.color}`]}>
            {workshop.cover && (
              <div class="workshop-cover">
                <ResponsivePhoto photo={workshop.cover} sizes="(min-width: 66rem) 390px, (min-width: 37rem) 57vw, 106vw" />
              </div>
            )}
            <div class="workshop-content">
              <p class="eyebrow workshop-category">{workshop.category}</p>
              <h3>{workshop.title}</h3>
              <p>{workshop.description}</p>
              {isOpen(workshop) && workshop.nextDate && <p class="workshop-date"><time datetime={workshop.nextDate.iso}>{workshop.nextDate.label}</time></p>}
              <a class="text-link" href={`/talleres/${workshop.slug}/`} aria-label={`Ver temario de ${workshop.title}`}>Ver temario</a>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </section>

  {photography.gallery.length > 0 && <Gallery photos={photography.gallery} />}

  <section class="registration-section" id="inscripcion" tabindex="-1" aria-labelledby="registration-title">
    <div class="wrap registration-inner">
      <div>
        <h2 id="registration-title">Cómo inscribirte</h2>
        <p>Consulta con la escuela antes de separar tu cupo.</p>
        <ContactLink class="button button-light">Escribir por WhatsApp</ContactLink>
      </div>
      <ol class="registration-steps" role="list">
        {registration.map((step) => <li><h3>{step.title}</h3><p>{step.detail}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section wrap visit-section" id="ubicacion" tabindex="-1" aria-labelledby="visit-title">
    <div class="visit-card">
      <p class="eyebrow">Ubicación de los talleres</p>
      <h2 id="visit-title">{site.city}, {site.region}</h2>
      {site.venue ? (
        <>
          <p>{site.venue.address}</p>
          <a class="button button-outline" href={site.venue.mapsUrl} rel="external noopener noreferrer">Cómo llegar en Google Maps</a>
        </>
      ) : (
        <>
          <p>Pídenos la dirección y una referencia al consultar por tu taller.</p>
          <ContactLink message={venueMessage} class="button button-outline">Pedir indicaciones</ContactLink>
        </>
      )}
    </div>
    <div class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Preguntas frecuentes</h2>
      {faqs.map(({ question, answer }) => (
        <details>
          <summary class="list-none">{question}<span aria-hidden="true"></span></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
</SiteLayout>
